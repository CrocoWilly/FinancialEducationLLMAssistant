# Address of the vLLM server (GPU machine), reachable over Tailscale.
# Must include /v1, no trailing slash.
UPSTREAM_LLM_BASE=http://<tailscale-ip>:8000/v1

# Shared secret Dify must send as "Authorization: Bearer <key>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BROKER_API_KEY=<random-secret>
